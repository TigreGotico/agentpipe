# Agentpipe Docker — API keys
# Kilo and OpenCode work without any of these (free-tier models).
# Only set what you need.

# Kilo/OpenCode/Aider (OpenRouter — optional, for paid models)
OPENROUTER_API_KEY=

# Qoder/Aider (OpenAI-compatible — optional)
OPENAI_API_KEY=

# Mistral Vibe (optional)
MISTRAL_API_KEY=

# Claude Code (set up after manual claude install)
ANTHROPIC_API_KEY=

# --- Server security settings ---
# Set to require Bearer-token auth on all endpoints (recommended in production).
# When unset the server runs in open-access mode (suitable for local dev).
AGENTPIPE_API_KEY=

# Maximum prompt length in characters (default: 100000)
AGENTPIPE_MAX_PROMPT_LENGTH=100000

# TTL in seconds for idle auto-created agents before eviction (default: 3600)
AGENTPIPE_AGENT_TTL=3600

# Serve every request with its own agent and resume no session (default: off).
# Set this on any deployment answering more than one person: without it,
# requests that carry no "user" share one agent and its conversation history.
AGENTPIPE_STATELESS=

# Concurrent provider subprocesses allowed in stateless mode (default: 4).
AGENTPIPE_MAX_CONCURRENCY=4

# Approval mode for the OpenAI-compatible surface (default: "default", which
# keeps the CLIs' file and shell tools behind their own permission prompts).
# Set to "bypass" only if a request body should be able to drive those tools.
AGENTPIPE_OPENAI_APPROVAL=

# Agentpipe Docker — API keys
# Kilo and OpenCode work without any of these (free-tier models).
# Only set what you need.

# Kilo/OpenCode/Aider (OpenRouter — optional, for paid models)
OPENROUTER_API_KEY=

# Qoder/Aider (OpenAI-compatible — optional)
OPENAI_API_KEY=

# Mistral Vibe (optional)
MISTRAL_API_KEY=

# Claude Code (set up after manual claude install)
ANTHROPIC_API_KEY=

# --- Server security settings ---
# Set to require Bearer-token auth on all endpoints (recommended in production).
# When unset the server runs in open-access mode (suitable for local dev).
AGENTPIPE_API_KEY=

# Maximum prompt length in characters (default: 100000)
AGENTPIPE_MAX_PROMPT_LENGTH=100000

# TTL in seconds for idle auto-created agents before eviction (default: 3600)
AGENTPIPE_AGENT_TTL=3600
